{
  "name": "@jiezhengj/subagent-oar-agy",
  "version": "0.2.8",
  "description": "Delegate independent tasks to the local Antigravity CLI (agy) from DSH; self-contained non-official plugin with a non-ACP AGY runtime and eight-language UI.",
  "type": "module",
  "icon": "./icon.svg",
  "files": [
    "LICENSE",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs",
    "locale",
    "provider",
    "tool.js"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.1",
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-experimental-tool-subagent-oar": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  },
  "exports": {
    "./agy-provider": "./provider/index.js",
    "./agy-provider/locale/*": "./provider/locale/*",
    "./locale/*": "./locale/*",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./tool": "./tool.js"
  },
  "scripts": {
    "build": "node scripts/vendor-provider.mjs",
    "verify": "node scripts/verify-package.mjs",
    "prepublishOnly": "pnpm --dir ../.. run build && node scripts/verify-package.mjs"
  },
  "devDependencies": {
    "@jiezhengj/subagent-oar-agy-provider": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiezhengj/DSH-Subagent-OAR-AGY.git"
  },
  "homepage": "https://github.com/jiezhengj/DSH-Subagent-OAR-AGY",
  "bugs": {
    "url": "https://github.com/jiezhengj/DSH-Subagent-OAR-AGY/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "subagent",
    "antigravity",
    "agy"
  ]
}
