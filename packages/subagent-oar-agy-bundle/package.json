{
  "name": "@jiezhengj/subagent_oar_agy",
  "version": "0.2.1",
  "description": "Delegate independent tasks to the local Antigravity CLI (agy) from DSH; non-official wrapper with a non-ACP AGY runtime.",
  "type": "module",
  "icon": "./icon.svg",
  "files": [
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "docs",
    "locale"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "listedByDefault": false
    }
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dependencies": {
    "@jiezhengj/subagent_oar_agy-provider": "workspace:*",
    "@deepseek-ai/dsh-experimental-tool-subagent-oar": "0.2.2-rc.1"
  }
}
